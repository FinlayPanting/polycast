{
  "name": "@polycast/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare-episode": "tsx src/cli/prepare.ts",
