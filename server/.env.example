# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=
REVENUECAT_WEBHOOK_SECRET=
# Optional: where alerts go, e.g. https://ntfy.sh/<your-private-topic>
ALERT_WEBHOOK_URL=
PORT=8787
RUN_WORKER=true
# Optional: a long random string; lets the morning email read the weekly funnel at /admin/funnel
FUNNEL_TOKEN=
# Learners' own API keys (PC-1017-K1): 32 random bytes, base64 (openssl rand -base64 32). Unset: off.
OWN_KEYS_SECRET=
# Optional: scale the own-keys cost estimate per provider once real preparations show it's off (default 1)
OWN_KEYS_ELEVEN_FACTOR=
OWN_KEYS_GOOGLE_FACTOR=
# The Lab test page on /lab (PC-1021-L1): its password, a long random string. Unset: the Lab is off.
LAB_TOKEN=
# Optional: Claude for the Lab's lesson-plan and script comparisons (Claude Haiku 5.5). Unset: those models are greyed out.
ANTHROPIC_API_KEY=
