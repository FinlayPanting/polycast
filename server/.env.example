# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=
REVENUECAT_WEBHOOK_SECRET=
# Optional: where alerts go, e.g. https://ntfy.sh/<your-private-topic>
ALERT_WEBHOOK_URL=
PORT=8787
RUN_WORKER=true
# Optional: a long random string; lets the morning email read the weekly funnel at /admin/funnel
FUNNEL_TOKEN=
# Optional: Sign in with Apple key (Apple Developer > Keys), so deleting an account also revokes Apple's sign-in link
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_KEY=
APPLE_CLIENT_ID=
