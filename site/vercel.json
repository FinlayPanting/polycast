{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/removal-requests", "destination": "https://polycast-production.up.railway.app/removal-requests" },
    { "source": "/api/creators/shows", "destination": "https://polycast-production.up.railway.app/creators/shows" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "build/*": false,
      "claude/*": false
    }
  }
}
